# ─────────────────────────────────────────────────────────────
# TESSCH Recommendation Engine — configuration
# Copy to `.env` and edit. Every value below is also the default,
# so an empty `.env` (or no `.env` at all) is a valid setup.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# SQLite — zero setup, single file, works immediately.
DATABASE_URL=sqlite:///data/tessch.db
SQL_ECHO=false

# Write-ahead logging. Leave false if this repo lives in OneDrive, Dropbox,
# Google Drive or a network share: WAL needs a shared-memory file those
# filesystems cannot provide, the mode is stored in the database header rather
# than the connection, and one successful switch makes the file permanently
# unopenable there. Set true only on a local disk.
SQLITE_WAL=false

# ── Synthetic data simulation ────────────────────────────────
# The whole simulated dataset is a deterministic function of these values:
# same seed in, byte-identical data out.
SIM_SEED=20260825
SIM_N_USERS=80
SIM_HISTORY_DAYS=30
SIM_END_DATE=2026-08-25

# ── Interest score weights ───────────────────────────────────
# How raw behaviour becomes one implicit-preference number.
# Phase 2 ("Picked for you") uses dwell time only, by design — it is meant to
# answer "what were you looking at", and dwell time answers that directly.
# These broader weights feed the Phase 3 user-item matrix.
W_VIEW=1.0
W_DWELL=1.5
W_REPEAT=2.0
W_CLICK=1.2
W_WISHLIST=4.0
W_CART=7.0
W_PURCHASE=12.0

# Time decay: score is multiplied by 0.5 ** (days_ago / HALF_LIFE_DAYS).
# 30 days means a product viewed a month ago counts half as much as today.
DECAY_HALF_LIFE_DAYS=30

# ── Dwell-time validation bounds (Phase 1 ingest) ────────────
# Anything outside these bounds is rejected rather than stored. A 0.3s "view"
# is a mis-click; a 3-hour "view" is an abandoned tab, not interest.
MIN_DWELL_SECONDS=1.0
MAX_DWELL_SECONDS=1800.0

# ── API ──────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
DEFAULT_TOP_K=8

# Comma-separated allowed origins for the browser tracker.
# "*" is fine for local development; name real origins in production.
CORS_ORIGINS=*
